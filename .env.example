# Optional public website URL for metadata. Vercel's production domain is used automatically.
# NEXT_PUBLIC_SITE_URL=https://your-portfolio.vercel.app

# Server-only: required for contact inbox submissions, not for building the website.
# Configure these in Vercel > Project > Settings > Environment Variables.
# Do not add NEXT_PUBLIC_ to these names.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
